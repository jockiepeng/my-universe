{
  "name": "my-universe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check",
    "test": "node --test tests/*.test.mjs",
    "build": "astro build && pagefind --site dist --force-language zh",
    "preview": "astro preview --host 127.0.0.1",
    "test:news": "node scripts/news-browser-smoke.mjs",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:search": "node scripts/search-browser-smoke.mjs",
    "test:entry": "node scripts/entry-first-paint-smoke.mjs",
    "test:scene": "node scripts/scene-consistency-smoke.mjs",
    "test:2048": "node scripts/planet-2048-browser-smoke.mjs",
    "test:arcade": "node scripts/arcade-browser-smoke.mjs",
    "test:music": "node scripts/music-browser-smoke.mjs",
    "test:visitors": "node scripts/visitor-info-browser-smoke.mjs",
    "test:metadata": "node scripts/post-metadata-browser-smoke.mjs",
    "test:life": "node scripts/life-grid-browser-smoke.mjs",
    "test:life-replay": "node scripts/life-replay-browser-smoke.mjs",
    "test:fortune": "node scripts/fortune-browser-smoke.mjs",
    "test:i18n": "node scripts/i18n-browser-smoke.mjs",
    "verify": "npm test && npm run check && npm run build && node scripts/check-build.mjs",
    "prepare": "node scripts/install-review-hooks.mjs",
    "hooks:install": "node scripts/install-review-hooks.mjs",
    "review:init": "node scripts/review-gate.mjs init",
    "review:verify": "node scripts/review-gate.mjs verify",
    "review:check": "node scripts/review-gate.mjs commit",
    "review:render": "node scripts/review-gate.mjs render",
    "review:amend": "node scripts/review-gate.mjs amend"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "astro": "^7.4.4",
    "pagefind": "^1.6.0",
    "playwright-core": "^1.64.1",
    "typescript": "^6.0.3"
  }
}
