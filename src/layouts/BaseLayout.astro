---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchDialog from '../components/SearchDialog.astro';
import BackToTop from '../components/BackToTop.astro';
import HomeScene from '../components/HomeScene.astro';
import EntryGate from '../components/EntryGate.astro';
import EntryBootstrap from '../components/EntryBootstrap.astro';
import MusicPlayer from '../components/MusicPlayer.astro';
import { siteConfig } from '../site.config';
import { href } from '../lib/posts';
import { dailyMotionPairs } from '../lib/motion.mjs';
import '../styles/global.css';
interface Props { title?: string; description?: string; article?: boolean; noIndex?: boolean; image?: string; home?: boolean }
const { title, description = siteConfig.description, article = false, noIndex = false, image, home = false } = Astro.props;
const pageTitle = title ? `${title} · ${siteConfig.title}` : siteConfig.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const showEntry = home && Astro.url.pathname === href('/');
---
<!doctype html>
<html id="page-top" lang="zh-CN" data-scene="galaxy" data-opening="particles" data-theme="auto" data-motion="on">
  <head>
    <meta charset="UTF-8" />
    <meta name="google-site-verification" content="ue-2oAe6Qqys_YzMSCM-kADrkXyKsBm-F_ryHgGDqow" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <title>{pageTitle}</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={href('/favicon.svg')} />
    <link rel="alternate" type="application/rss+xml" title={`${siteConfig.title} RSS`} href={href('/rss.xml')} />
    <meta property="og:title" content={pageTitle} /><meta property="og:description" content={description} />
    <meta property="og:type" content={article ? 'article' : 'website'} /><meta property="og:url" content={canonical} />
    <meta property="og:locale" content="zh_CN" /><meta property="og:site_name" content={siteConfig.title} />
    {image && <meta property="og:image" content={new URL(image, Astro.site).href} />}
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    <script is:inline define:vars={{ dailyMotionPairs }}>
      (() => {
        const el = document.documentElement;
        el.classList.add('js');
        let data = {};
        try {
          const stored = JSON.parse(localStorage.getItem('little-universe-appearance-v1') || 'null');
          if (stored && typeof stored === 'object' && !Array.isArray(stored)) data = stored;
        } catch { /* Daily appearance still works without storage. */ }
        const parts = Object.fromEntries(new Intl.DateTimeFormat('en-GB', {
          timeZone: 'Asia/Shanghai', year: 'numeric', month: '2-digit', day: '2-digit',
        }).formatToParts(new Date()).map(part => [part.type, part.value]));
        const today = `${parts.year}-${parts.month}-${parts.day}`;
        const daily = dailyMotionPairs[Number(parts.day) % 10 % dailyMotionPairs.length];
        const manualScene = data.selectionDate === today && dailyMotionPairs.some(pair => pair.scene === data.scene);
        const manualOpening = data.selectionDate === today && dailyMotionPairs.some(pair => pair.opening === data.opening);
        el.dataset.scene = manualScene ? data.scene : daily.scene;
        el.dataset.opening = manualOpening ? data.opening : daily.opening;
        el.dataset.sceneMode = manualScene ? 'manual' : 'daily';
        el.dataset.motionDay = today;
        if (['auto', 'light', 'dark'].includes(data.theme)) {
          el.dataset.theme = data.theme;
          el.style.colorScheme = data.theme === 'auto' ? 'light dark' : data.theme;
        }
        if (data.motion === false || matchMedia('(prefers-reduced-motion:reduce)').matches) el.dataset.motion = 'off';
      })();
    </script>
    {showEntry && <EntryBootstrap />}
  </head>
  <body class="universe" data-home={home || undefined} data-production-origin={Astro.site?.origin}>
    <HomeScene animated={home} />
    {showEntry && <EntryGate />}
    <a class="u-skip" href="#main-content">跳到正文</a>
    <Header home={showEntry} />
    <div class="u-page">
      <div class="u-wrap">
        <main id="main-content" tabindex="-1"><slot /></main>
      </div>
    </div>
    <Footer />
    <MusicPlayer />
    {article && <BackToTop />}
    <SearchDialog />
    <script>
      import '../scripts/appearance';
      import '../scripts/fixed-bars';
      import '../scripts/page-views';
    </script>
  </body>
</html>
