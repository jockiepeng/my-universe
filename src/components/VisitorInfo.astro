---
import Icon from './Icon.astro';
---
<section class="u-visitor-info" aria-label="访客信息" data-pagefind-ignore>
  <p aria-label="IP 归属地" title="根据当前网络出口 IP 查询的大致归属地，使用代理时可能显示代理所在地">
    <Icon name="location" size={14} /><span data-visitor-location aria-live="polite">需要 JavaScript</span>
  </p>
  <p data-site-views title="全站页面浏览次数，刷新或重复打开可能再次计数">
    <span>累计浏览量</span>
    <span><span data-views-fallback>—</span><span id="busuanzi_container_site_pv" style="display:none"><span id="busuanzi_value_site_pv"></span></span> 次</span>
  </p>
</section>
<script>
  import '../scripts/visitor-info';
</script>
<style>
  .u-visitor-info { display:flex; flex-wrap:wrap; gap:10px 30px; margin:0 0 26px; padding:12px 0; border-block:1px solid var(--u-line); color:var(--u-muted); font-size:12px; line-height:1.8; }
  p { display:flex; align-items:center; flex-wrap:wrap; gap:4px 10px; margin:0; min-width:0; }
  p :global(svg) { flex-shrink:0; }
  [data-visitor-location] { overflow-wrap:anywhere; }
  [data-site-views] { font-variant-numeric:tabular-nums; }
  [data-site-views] > span:last-child { white-space:nowrap; }
</style>
