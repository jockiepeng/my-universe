---
import Icon from './Icon.astro';
---
<section class="u-visitor-info" aria-label="访客信息" data-pagefind-ignore>
  <p aria-label="IP 归属地" title="根据当前网络出口 IP 查询的大致归属地，使用代理时可能显示代理所在地">
    <Icon name="location" size={14} /><span data-visitor-location aria-live="polite">需要 JavaScript</span>
  </p>
  <p data-site-views title="全站页面浏览次数，刷新或重复打开可能再次计数">
    <span>博客累计浏览量</span>
    <span><span data-views-fallback>—</span><span id="busuanzi_container_site_pv" style="display:none"><span id="busuanzi_value_site_pv"></span></span> 次</span>
  </p>
</section>
<script>
  import '../scripts/visitor-info';
</script>
<style>
  .u-visitor-info { display:flex; justify-content:flex-end; align-items:center; flex-wrap:nowrap; gap:14px; margin:0; padding:0; order:4; max-width:34%; color:var(--u-muted); font-size:11px; line-height:1.8; min-width:0; }
  p { display:flex; align-items:center; gap:6px; margin:0; min-width:0; max-width:100%; }
  p :global(svg) { flex-shrink:0; }
  [data-visitor-location] { overflow:hidden; white-space:nowrap; text-overflow:ellipsis; }
  [data-site-views] { font-variant-numeric:tabular-nums; flex-shrink:0; white-space:nowrap; }
  [data-site-views] > span:last-child { white-space:nowrap; }
  @media (max-width:1000px) { .u-visitor-info { margin-left:auto; max-width:60%; } }
  @media (max-width:580px) { .u-visitor-info { max-width:calc(100% - 76px); gap:8px; font-size:10px; } p { gap:4px; } }
</style>
