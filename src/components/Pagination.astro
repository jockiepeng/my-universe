---
import Icon from './Icon.astro';
import { href } from '../lib/posts';
interface Props { current: number; total: number }
const { current, total } = Astro.props;
const pageHref = (n: number) => href(n === 1 ? '/' : `/page/${n}/`);
---
{total > 1 && <nav class="u-pagination" aria-label="文章分页">
  {current > 1 ? <a href={pageHref(current - 1)} rel="prev"><Icon name="left" />上一页</a> : <span></span>}
  <span>第 {current} / {total} 页</span>
  {current < total ? <a href={pageHref(current + 1)} rel="next">下一页<Icon name="right" /></a> : <span></span>}
</nav>}
