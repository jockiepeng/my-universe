---
import ArticleMeta from './ArticleMeta.astro';
import { summarize } from '../lib/content.mjs';
import { href, postHref, type Post } from '../lib/posts';
interface Props { posts: Post[]; filters?: boolean }
const { posts, filters = false } = Astro.props;
---
<div class="u-post-list" data-post-list>
  {posts.map(post => <article class="u-post" data-kind={post.data.kind}>
    <div>
      <ArticleMeta post={post} />
      <h3><a href={postHref(post)}>{post.data.title}</a></h3>
      <p>{post.data.summary || summarize(post.body)}</p>
      {post.data.tags.length > 0 && <div class="u-tags">{post.data.tags.map(tag => <a href={href(`/tags/${encodeURIComponent(tag)}/`)}># {tag}</a>)}</div>}
    </div>
  </article>)}
  {posts.length === 0 && <p class="u-empty">这里还没有文章，过段时间再来看看。</p>}
  {filters && <p class="u-empty" data-filter-empty hidden>这一页暂时没有这类记录，可以切换筛选或去归档看看。</p>}
</div>
