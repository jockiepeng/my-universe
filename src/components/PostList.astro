---
import { Image } from 'astro:assets';
import ArticleMeta from './ArticleMeta.astro';
import { summarize } from '../lib/content.mjs';
import { href, postHref, type Post } from '../lib/posts';
interface Props { posts: Post[]; filters?: boolean; initialIds?: string[] }
const { posts, filters = false, initialIds } = Astro.props;
const initial = initialIds ? new Set(initialIds) : undefined;
---
<div class="u-post-list" data-post-list>
  {posts.map(post => {
    const thumbnail = post.data.thumbnail || post.data.cover || post.data.images[0]?.src;
    const thumbnailAlt = post.data.thumbnail ? post.data.thumbnailAlt : post.data.cover ? post.data.coverAlt : post.data.images[0]?.alt;
    return <article class="u-post" data-kind={post.data.kind} data-category={post.data.category} data-initial={String(!initial || initial.has(post.id))} hidden={initial && !initial.has(post.id)}>
      <ArticleMeta post={post} />
      <div class:list={['u-post-body', { 'has-thumbnail': thumbnail }]}>
        <div class="u-post-copy">
          <h3 data-i18n-skip lang="zh-CN"><a href={postHref(post)}>{post.data.title}</a></h3>
          <p data-i18n-skip lang="zh-CN">{post.data.summary || summarize(post.body)}</p>
          {post.data.tags.length > 0 && <div class="u-tags">{post.data.tags.map(tag => <a href={href(`/tags/${encodeURIComponent(tag)}/`)}># {tag}</a>)}</div>}
        </div>
        {thumbnail && <Image data-i18n-skip src={thumbnail} alt={thumbnailAlt || post.data.title} width={144} height={96} widths={[144, 288]} sizes="(max-width: 580px) 96px, 144px" fit="cover" loading="lazy" class="u-post-thumbnail" />}
      </div>
    </article>;
  })}
  {posts.length === 0 && <p class="u-empty">这里还没有文章，过段时间再来看看。</p>}
  {filters && <p class="u-empty" data-filter-empty hidden>当前分类下没有这类内容，试试其他分类或切换到“全部”。</p>}
</div>

<style>
  .u-post-body { display:flex; align-items:center; gap:22px; }
  .u-post-copy { flex:1; min-width:0; overflow-wrap:anywhere; }
  .u-post-copy .u-tags { flex-wrap:wrap; gap:6px 14px; }
  .u-post-thumbnail { display:block; flex:none; width:144px; height:96px; object-fit:cover; border-radius:6px; background:var(--u-soft); }
  .has-thumbnail p { display:-webkit-box; -webkit-box-orient:vertical; -webkit-line-clamp:2; overflow:hidden; }
  @media (max-width:580px) {
    .u-post-body { gap:14px; }
    .u-post-thumbnail { width:96px; height:64px; }
    .has-thumbnail p { -webkit-line-clamp:3; }
  }
</style>
