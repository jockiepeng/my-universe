---
import Icon from './Icon.astro';
import CalendarClock from './CalendarClock.astro';
import { href } from '../lib/posts';
import { siteConfig } from '../site.config';
const pathname = Astro.url.pathname;
const nav = [{ path: '/', label: '首页' }, { path: '/archive/', label: '归档' }, { path: '/about/', label: '关于我' }];
---
<header class="u-header-shell" data-pagefind-ignore>
 <div class="u-header-container">
  <div class="u-header u-wrap">
  <a class="u-brand" href={href('/')}><span class="u-mark" aria-hidden="true"></span>{siteConfig.title}</a>
  <CalendarClock />
  <nav class="u-nav" aria-label="主导航">
    {nav.map(item => <a href={href(item.path)} aria-current={pathname === href(item.path) ? 'page' : undefined}>{item.label}</a>)}
  </nav>
  <div class="u-actions" data-enhanced>
    <div class="u-scene-control">
      <button class="u-icon u-scene-trigger" type="button" data-scene-toggle aria-label="切换背景" aria-expanded="false" aria-controls="scene-picker"><Icon name="image" /><span data-scene-label>深空</span></button>
      <div class="u-scene-picker" id="scene-picker" hidden>
        <p class="u-scene-heading">换个风景，继续记录</p>
        <div class="u-scene-options" role="group" aria-label="选择背景场景">
          <button type="button" class="u-scene-option" data-scene-option="space" aria-pressed="true"><span class="u-scene-thumb space" aria-hidden="true"></span><strong>深空</strong><small>星点与缓慢的轨道</small></button>
          <button type="button" class="u-scene-option" data-scene-option="beach" aria-pressed="false"><span class="u-scene-thumb beach" aria-hidden="true"></span><strong>沙滩</strong><small>海风与轻轻的潮汐</small></button>
        </div>
        <p class="u-scene-picker-note">背景与深浅色可以自由搭配，选择会保存在当前浏览器。</p>
      </div>
    </div>
    <button class="u-icon" type="button" data-search-open aria-label="搜索文章" aria-controls="site-search" aria-haspopup="dialog"><Icon name="search" /></button>
    <button class="u-icon" type="button" data-theme-toggle aria-label="切换深浅色主题"><Icon name="theme" /></button>
  </div>
  </div>
 </div>
</header>
