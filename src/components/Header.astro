---
import Icon from './Icon.astro';
import CalendarClock from './CalendarClock.astro';
import VisitorInfo from './VisitorInfo.astro';
import { href } from '../lib/posts';
import { siteConfig } from '../site.config';
import { scenePresets, openingPresets } from '../lib/motion.mjs';
interface Props { home?: boolean }
const { home = false } = Astro.props;
const pathname = Astro.url.pathname;
const nav = [{ path: '/', label: '首页' }, { path: '/archive/', label: '归档' }, { path: '/games/', label: '游戏' }, { path: '/about/', label: '关于我' }];
---
<header class="u-header-shell" data-pagefind-ignore>
 <div class="u-header-container">
  <div class="u-header u-wrap">
  <a class="u-brand" href={href('/')} aria-label={siteConfig.title}><span class="u-mark" aria-hidden="true"></span><span class="u-brand-name">{siteConfig.title}</span></a>
  <button class="u-icon u-header-menu-toggle" type="button" data-header-menu-toggle data-enhanced aria-label="展开导航与操作" aria-expanded="false" aria-controls="header-controls"><Icon name="menu" /></button>
  <div class="u-header-controls" id="header-controls" data-header-controls>
  <CalendarClock />
  <nav class="u-nav" aria-label="主导航">
    {nav.map(item => <a href={href(item.path)} aria-current={pathname === href(item.path) || (item.path === '/games/' && pathname.startsWith(href('/games/'))) ? 'page' : undefined}>{item.label}</a>)}
  </nav>
  <div class="u-actions" data-enhanced>
    <div class="u-scene-control">
      <button class="u-icon u-scene-trigger" type="button" data-scene-toggle aria-label="切换背景" aria-expanded="false" aria-controls="scene-picker"><Icon name="image" /><span data-scene-label>星系</span></button>
      <div class="u-scene-picker" id="scene-picker" hidden>
        <p class="u-scene-heading">换个风景，继续记录</p>
        <div class="u-scene-options" role="group" aria-label="选择背景场景">
          {scenePresets.map(scene => <button type="button" class="u-scene-option" data-scene-option={scene.id} aria-pressed="false"><span class={`u-scene-thumb ${scene.id}`} aria-hidden="true"></span><strong>{scene.name}</strong><small>{scene.description}</small></button>)}
        </div>
        {home && <><p class="u-scene-heading u-opening-heading">开场方式</p><div class="u-opening-options" role="group" aria-label="选择开场方式">{openingPresets.map(opening => <button type="button" data-opening-option={opening.id} aria-pressed="false">{opening.name}</button>)}</div><button class="u-entry-replay" type="button" data-intro-replay>重播开场</button></>}
        <button class="u-scene-daily" type="button" data-motion-daily aria-pressed="true">恢复今日自动组合</button>
        <p class="u-scene-picker-note" data-scene-status>按北京时间日期尾号自动选择</p>
      </div>
    </div>
    <button class="u-icon" type="button" data-search-open aria-label="搜索文章" aria-controls="site-search" aria-haspopup="dialog"><Icon name="search" /></button>
    <button class="u-icon" type="button" data-theme-toggle aria-label="切换深浅色主题"><Icon name="theme" /></button>
  </div>
  </div>
  <VisitorInfo />
  </div>
 </div>
</header>
<script>
  import '../scripts/header-menu';
</script>
