---
import Icon from './Icon.astro';
---
<dialog id="site-search" class="u-search-dialog" aria-labelledby="search-title" data-pagefind-ignore>
  <div class="u-search-heading"><h2 id="search-title">在这片小宇宙里找一找</h2><button class="u-icon" type="button" data-search-close aria-label="关闭搜索"><Icon name="close" /></button></div>
  <label class="u-sr-only" for="search-input">搜索文章与贴图</label>
  <input class="u-search-input" id="search-input" type="search" placeholder="搜索文章、日常或工具…" autocomplete="off" />
  <p class="u-search-status" data-search-status role="status">输入关键词，搜索文章与贴图。</p>
  <div class="u-search-results" data-search-results></div>
</dialog>
<script>
  import '../scripts/search';
</script>
