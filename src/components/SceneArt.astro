<div class="u-cosmos" aria-hidden="true">
  <div class="u-space-scene">
    <div class="u-star-layer">{Array.from({ length: 39 }, (_, i) => <span class="u-spark" style={`left:${(i * 41 + 7) % 97}%;top:${(i * 29 + 11) % 91}%;width:${i % 8 ? 1.4 : 2.8}px;height:${i % 8 ? 1.4 : 2.8}px;opacity:${.2 + i % 5 * .11}`}></span>)}</div>
    <span class="u-ring third"></span><span class="u-ring"></span><span class="u-ring second"></span><span class="u-sun"></span><span class="u-planet"></span><span class="u-planet small"></span>
  </div>
  <div class="u-beach-scene"><span class="u-beach-sun"></span><span class="u-beach-cloud"></span><span class="u-beach-wave"></span><span class="u-beach-wave second"></span><span class="u-beach-shore"></span></div>
  <span class="u-cosmos-caption"><span class="u-space-copy">每一个念头，都有自己的轨道</span><span class="u-beach-copy">让想法，随着海风慢慢展开</span></span>
</div>
