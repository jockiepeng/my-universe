---
import tracks from '../data/music-tracks.json';
import { href } from '../lib/posts';
import '../styles/music-player.css';
const playlist = tracks.map(track => ({ ...track, url: href(track.file) }));
---
<details class="u-music" data-music data-pagefind-ignore hidden>
  <summary class="u-music-summary" data-music-summary aria-label="背景音乐，展开播放器">
    <svg class="u-music-note" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M9 18V5l12-2v13M9 9l12-2"/><ellipse cx="6" cy="18" rx="3" ry="2.5"/><ellipse cx="18" cy="16" rx="3" ry="2.5"/></svg>
    <span>背景音乐</span><span class="u-music-mini" data-music-mini>点播</span>
  </summary>
  <section class="u-music-panel" data-music-panel aria-label="背景音乐播放器">
    <div class="u-music-heading"><h2>听点音乐</h2><button type="button" class="u-music-close" data-music-close aria-label="收起音乐播放器">×</button></div>
    <p class="u-music-title" data-music-title>Moonlight</p>
    <p class="u-music-status" data-music-status role="status">点击播放，让音乐陪你读一会儿。</p>
    <div class="u-music-controls">
      <button type="button" data-music-prev aria-label="上一首"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 5v14M19 5 8 12l11 7Z"/></svg></button>
      <button type="button" class="u-music-play" data-music-play aria-label="播放背景音乐"><span data-music-play-label>播放</span></button>
      <button type="button" data-music-next aria-label="下一首"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M19 5v14M5 5l11 7-11 7Z"/></svg></button>
    </div>
    <div class="u-music-progress"><span data-music-elapsed>0:00</span><label class="u-music-seek"><span class="u-music-sr">播放进度，秒</span><input type="range" data-music-seek min="0" max="1" value="0" step="1" disabled /></label><span data-music-duration>0:00</span></div>
    <label class="u-music-volume">音量<input type="range" data-music-volume min="0" max="1" step="0.05" value="0.2" /><output data-music-volume-label>20%</output></label>
    <ol class="u-music-playlist" aria-label="曲目列表">
      {playlist.map(track => <li><button type="button" data-music-track={track.id} aria-pressed={track.id === 'moonlight'}><span>{track.title}</span><small>{track.artist.replace(' (incompetech.com)', '')}</small></button></li>)}
    </ol>
    <p class="u-music-credit"><a data-music-source href={playlist[0].source} target="_blank" rel="noopener noreferrer"><span data-music-credit>Moonlight by Scott Buckley</span></a><br />Released under <a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noopener noreferrer">CC BY 4.0</a></p>
    <audio data-music-audio preload="none"></audio>
    <script type="application/json" data-music-playlist set:html={JSON.stringify(playlist)} />
  </section>
</details>
<script>
  import '../scripts/music-player';
</script>
