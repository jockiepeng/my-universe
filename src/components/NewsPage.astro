---
import BaseLayout from '../layouts/BaseLayout.astro';
import snapshot from '../data/news.json';
import sync from '../data/news-sync.json';
import { href } from '../lib/posts';
import type { NewsSnapshot, NewsReport } from '../lib/news-types';
interface Props { report?: NewsReport }
const { report } = Astro.props;
const data = snapshot as NewsSnapshot;
const index = report ? data.reports.findIndex(r => r.id === report.id) : -1;
const newer = index > 0 ? data.reports[index - 1] : null;
const older = index >= 0 ? data.reports[index + 1] : null;
const time = data.updatedAt ? new Intl.DateTimeFormat('zh-CN', { timeZone: 'Asia/Shanghai', dateStyle: 'medium', timeStyle: 'short' }).format(new Date(data.updatedAt)) : null;
---
<BaseLayout title="每日新闻" description="每天十条值得关注的新闻，与历史上的今天。">
  <div class="news-page">
    <header class="news-header"><div><p class="news-eyebrow">每日新闻</p><h1>读懂今天，也回望历史</h1><p>每天十条值得关注的新闻，与历史上的今天。</p></div><a class="news-source" href="https://github.com/jockiepeng/my-universe/discussions/9" target="_blank" rel="noopener noreferrer">查看日报来源 ↗</a></header>
    <p class="news-status" data-news-status data-latest-date={data.reports[0]?.date || ''} data-sync-failed={sync.status === 'failed' ? 'true' : 'false'} role="status">{sync.status === 'failed' ? (report ? '本次日报同步失败，正在显示上次成功同步的内容。' : '日报同步暂时失败，请稍后再来或查看 GitHub 来源。') : (!report ? '尚无已同步日报，请稍后再来。' : '')}</p>
    <div class="news-layout">
      <aside class="news-archive" aria-label="历史日报" data-pagefind-ignore>
        <h2>历史日报</h2><a class="news-latest" href={href('/news/')}>最新一期</a>
        {data.reports.length ? <nav aria-label="按日期浏览日报">{data.reports.map(r => <a href={href(`/news/${r.date}/`)} aria-current={report?.id === r.id ? 'page' : undefined}><time datetime={r.date}>{r.date}</time><span data-i18n-en={`${r.articles.length} ${r.articles.length === 1 ? 'story' : 'stories'}`}>{r.articles.length} 条新闻</span></a>)}</nav> : <p>尚无历史日报。</p>}
        <p class="news-note">每天北京时间 08:40 推送，随后同步部署；内容不足时按实际条数展示。</p>
        {time ? <p class="news-note">最近同步：<time datetime={data.updatedAt!} data-i18n-skip>{time}</time><span>（北京时间）</span></p> : <p class="news-note">尚未同步日报。</p>}
      </aside>
      <div class="news-main">
        {report ? <article data-news-report={report.id} data-news-date={report.date}>
          <header class="news-edition"><div><h2><time datetime={report.date}>{report.date}</time><span> 日报</span></h2><p><span data-i18n-en={`${report.articles.length} ${report.articles.length === 1 ? 'story' : 'stories'}`}>{report.articles.length} 条新闻</span><span> · </span><span data-i18n-en={`${Math.min(3, report.history.length)} historical ${report.history.length === 1 ? 'event' : 'events'}`}>{Math.min(3, report.history.length)} 条历史事件</span></p></div><a href={report.url} target="_blank" rel="noopener noreferrer">查看原始日报 ↗</a></header>
          <div class="news-stories">{report.articles.map((story, i) => <section class="news-card" aria-labelledby={`news-${i}`}><header><span class="news-number" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span><h3 id={`news-${i}`} data-i18n-skip lang="zh-CN">{story.title}</h3></header><p class="news-summary" data-i18n-skip lang="zh-CN">{story.summary}</p><div class="news-value"><h4>新闻价值</h4><p data-i18n-skip lang="zh-CN">{story.value}</p></div><footer><div><span>来源：</span><span data-i18n-skip>{story.source}</span><small data-i18n-skip>{story.basis}</small></div><a href={story.url} target="_blank" rel="noopener noreferrer">阅读原文 ↗</a></footer></section>)}</div>
          <section class="news-history" aria-labelledby="history-title"><header><p class="news-eyebrow">回望历史</p><h2 id="history-title">历史上的今天</h2></header>{report.history.length ? report.history.slice(0, 3).map(event => <article class="news-event"><time datetime={event.date}>{event.date}</time><h3 data-i18n-skip lang="zh-CN">{event.title}</h3><p data-i18n-skip lang="zh-CN">{event.summary}</p><a href={event.url} target="_blank" rel="noopener noreferrer">事件来源 ↗</a></article>) : <p>本期暂无历史事件。</p>}</section>
          <nav class="news-paging" aria-label="切换日报">{newer ? <a href={href(`/news/${newer.date}/`)}>← <span>较新一期</span> <time>{newer.date}</time></a> : <span></span>}{older && <a href={href(`/news/${older.date}/`)}><span>较早一期</span> <time>{older.date}</time> →</a>}</nav>
        </article> : <section class="news-empty"><h2>日报正在路上</h2><p>还没有已同步的新闻，请稍后再来。</p><p>你也可以前往 GitHub 查看最新日报。</p></section>}
      </div>
    </div>
  </div>
</BaseLayout>
<script>import '../scripts/news';</script>
<style>
.news-page { max-width:1100px; margin:0 auto; padding:24px 0 48px; }
.news-header { display:flex; align-items:flex-end; justify-content:space-between; gap:24px; padding-bottom:24px; border-bottom:1px solid var(--u-line); }
.news-eyebrow { color:var(--u-link); font-size:12px; font-weight:700; letter-spacing:.12em; margin:0 0 10px; }
h1 { font-size:clamp(27px,4vw,38px); margin:0 0 14px; line-height:1.4; }
.news-header p:not(.news-eyebrow), .news-status { color:var(--u-muted); font-size:14px; line-height:1.8; }
.news-header p:last-child { margin-bottom:0; }
.news-source { flex-shrink:0; font-size:13px; }
.news-status { min-height:25px; margin:18px 0; }
.news-layout { display:grid; grid-template-columns:210px minmax(0,1fr); gap:36px; }
.news-archive { align-self:start; position:sticky; top:calc(var(--u-header-height) + 20px); }
.news-archive h2 { font-size:15px; margin:0 0 14px; }
.news-archive nav { display:flex; flex-direction:column; max-height:340px; overflow:auto; margin:10px 0 20px; }
.news-archive nav a { display:flex; flex-wrap:wrap; justify-content:space-between; gap:5px; padding:12px 8px; border-bottom:1px solid var(--u-line); font-size:13px; }
.news-archive nav a[aria-current] { background:var(--u-soft); font-weight:700; }
.news-archive nav span { color:var(--u-muted); font-size:11px; }
.news-latest { font-size:13px; }
.news-note { font-size:12px; line-height:1.9; color:var(--u-muted); }
.news-main { min-width:0; }
.news-edition { display:flex; justify-content:space-between; align-items:center; gap:16px; margin:0 0 22px; }
.news-edition h2 { font-size:22px; margin:0; }
.news-edition p { font-size:12px; color:var(--u-muted); margin-bottom:0; }
.news-edition > a { font-size:12px; flex-shrink:0; }
.news-card { padding:26px; border:1px solid var(--u-line); border-radius:12px; background:var(--u-paper); margin-bottom:20px; }
.news-card > header { display:flex; align-items:baseline; gap:14px; }
.news-number { font-size:15px; color:var(--u-muted); font-variant-numeric:tabular-nums; }
h3 { margin:0; font-size:19px; line-height:1.65; overflow-wrap:anywhere; }
.news-summary, .news-value p, .news-event p { white-space:pre-wrap; overflow-wrap:anywhere; line-height:1.95; font-size:15px; }
.news-value { padding:14px 16px; border-left:2px solid var(--u-link); background:var(--u-soft); border-radius:0 6px 6px 0; margin:20px 0; }
.news-value h4 { margin:0; color:var(--u-link); font-size:12px; }
.news-value p { margin:8px 0 0; font-size:14px; }
.news-card footer { display:flex; justify-content:space-between; align-items:flex-end; gap:18px; color:var(--u-muted); font-size:12px; line-height:1.8; }
.news-card small { display:block; font-size:11px; }
.news-card footer a { flex-shrink:0; }
.news-history { margin-top:44px; padding-top:28px; border-top:1px solid var(--u-line); }
.news-history h2 { font-size:23px; margin:0 0 22px; }
.news-event { padding:18px 0; border-bottom:1px solid var(--u-line); }
.news-event time { color:var(--u-link); font-size:13px; }
.news-event h3 { margin-top:8px; font-size:17px; }
.news-event a { font-size:12px; }
.news-paging { display:flex; justify-content:space-between; flex-wrap:wrap; gap:20px; margin-top:30px; font-size:13px; }
.news-empty { padding:36px 24px; background:var(--u-paper); border:1px solid var(--u-line); border-radius:12px; }
.news-empty h2 { font-size:23px; }
.news-empty p { color:var(--u-muted); line-height:1.9; }
@media(max-width:720px) { .news-header { display:block; }.news-source { display:inline-block; margin-top:18px; }.news-layout { grid-template-columns:1fr; gap:24px; }.news-archive { position:static; }.news-archive nav { flex-direction:row; gap:8px; overflow:auto; max-height:none; }.news-archive nav a { flex:0 0 auto; display:block; padding:10px; border:1px solid var(--u-line); border-radius:6px; }.news-archive nav span { display:block; margin-top:3px; }.news-note { margin:8px 0; }.news-card { padding:20px 16px; }.news-card > header { gap:10px; }.news-edition { flex-wrap:wrap; }.news-edition h2 { font-size:20px; }.news-card footer { flex-wrap:wrap; } }
</style>
