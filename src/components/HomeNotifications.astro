---
import snapshot from '../data/plans.json';
import { href } from '../lib/posts';
---
<div class="profile-notifications" data-home-notifications data-plans={JSON.stringify(snapshot.moments)} data-enhanced data-pagefind-ignore>
  <details class="profile-menu" data-profile-menu>
    <summary aria-label="打开头像菜单" title="通知菜单">
      <svg class="profile-avatar" viewBox="0 0 40 40" role="img" aria-label="小宇宙头像"><rect x="1" y="1" width="38" height="38" rx="12" fill="#e8edf9" /><circle cx="20" cy="20" r="9" fill="#6676b8" /><ellipse cx="20" cy="20" rx="16" ry="5" transform="rotate(-30 20 20)" fill="none" stroke="#384b8b" stroke-width="2" /><circle cx="30" cy="8" r="2" fill="#dfac55" /></svg>
      <span class="notification-dot avatar-dot" data-notification-dot hidden aria-label="有未读通知"></span>
    </summary>
    <div class="profile-dropdown"><button type="button" data-notification-open>通知 <span data-notification-count>（0）</span><span class="notification-dot" data-notification-dot hidden aria-label="有未读通知"></span></button></div>
  </details>
  <dialog class="notification-dialog" data-notification-dialog aria-labelledby="notification-title">
    <header><h2 id="notification-title">通知</h2><button type="button" data-notification-close aria-label="关闭通知">×</button></header>
    <p data-notification-empty hidden>暂无需要关注的通知。</p>
    <div class="notification-panel">
      <p>计划日期已过，以下规划仍未完成。</p>
      <ul data-notification-list></ul>
      <a href={href('/plans/')}>查看全部规划 →</a>
    </div>
    <p class="notification-note">按北京时间判断；规划状态需等待同步部署。已读仅保存在当前浏览器。</p>
  </dialog>
</div>
<script>
  import '../scripts/home-notifications';
</script>
<style>
  .profile-notifications { position:relative; flex-shrink:0; order:4; }
  .profile-menu > summary { cursor:pointer; list-style:none; display:flex; position:relative; border-radius:12px; }
  .profile-menu > summary::-webkit-details-marker { display:none; }
  .profile-avatar { width:38px; height:38px; border:1px solid var(--u-line); border-radius:12px; }
  summary:focus-visible, button:focus-visible { outline:2px solid var(--u-link); outline-offset:4px; }
  .notification-dot { display:inline-block; width:8px; height:8px; margin-left:8px; border-radius:50%; background:#dc3535; vertical-align:middle; }
  .notification-dot[hidden], [hidden] { display:none; }
  .avatar-dot { position:absolute; top:0; right:0; border:2px solid var(--u-bg); margin:0; }
  .profile-dropdown { position:absolute; right:0; top:calc(100% + 10px); min-width:170px; padding:8px; border:1px solid var(--u-line); border-radius:10px; background:var(--u-paper); box-shadow:0 10px 30px #0002; }
  button { color:var(--u-text); font:inherit; cursor:pointer; }
  .profile-dropdown button { display:block; width:100%; padding:12px; border:0; border-radius:6px; background:transparent; text-align:left; }
  .profile-dropdown button:hover { background:var(--u-soft); }
  .notification-dialog { width:min(520px,calc(100vw - 40px)); box-sizing:border-box; max-height:80dvh; overflow:auto; padding:24px; border:1px solid var(--u-line); border-radius:14px; background:var(--u-paper); color:var(--u-text); }
  .notification-dialog::backdrop { background:#0006; }
  header { display:flex; align-items:center; justify-content:space-between; gap:16px; }
  h2 { font-size:20px; margin:0; }
  header button { width:36px; height:36px; border:1px solid var(--u-line); border-radius:6px; background:transparent; font-size:24px; }
  p { color:var(--u-muted); font-size:13px; line-height:1.7; }
  ul { list-style:none; padding:0; margin:14px 0; }
  .notification-panel :global(li) { display:flex; flex-wrap:wrap; justify-content:space-between; gap:8px 18px; padding:12px 0; border-top:1px solid var(--u-line); }
  .notification-panel :global(li a) { overflow-wrap:anywhere; }
  .notification-panel :global(li span) { color:var(--u-muted); font-size:13px; }
  .notification-note { margin-bottom:0; font-size:12px; }
  @media(max-width:1000px) { .profile-dropdown { position:fixed; right:16px; top:calc(var(--u-header-height) + 8px); } }
</style>
