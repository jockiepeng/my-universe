---
import DailyQuote from './DailyQuote.astro';
import PostList from './PostList.astro';
import Pagination from './Pagination.astro';
import Icon from './Icon.astro';
import TopicTree from './TopicTree.astro';
import PostFilters from './PostFilters.astro';
import SubcategoryFilters from './SubcategoryFilters.astro';
import { topicTree } from '../lib/topics.mjs';
import { href, type Post } from '../lib/posts';
interface Props { posts: Post[]; allPosts: Post[]; current?: number; total: number }
const { posts, allPosts, current = 1, total } = Astro.props;
const tags = [...new Set(allPosts.flatMap(post => post.data.tags))].slice(0, 8);
const rootTopics = topicTree(allPosts);
---
{current === 1 ? <div class="u-hero u-home-hero">
  <div class="u-hero-copy">
    <h1>写下生活，<br />也写下新的发现。</h1>
    <p>一些日常，一些思考，还有路上捡到的经验。</p>
    <a class="u-intro-link" href={href('/about/')}>认识一下这里的我 <Icon name="external" size={14} /></a>
    <a class="u-game-link" href={href('/games/')}><span aria-hidden="true">⚄</span> 去玩个小游戏 <Icon name="external" size={14} /></a>
    <a class="f-home-link" href={href('/tools/fortune/')}><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><path d="M5 8l1 10h8l1-10M5 8q5 3 10 0M7 8L5 2m5 7V1m3 8 2-6M7 14h6" /></svg> 求一支签 <Icon name="external" size={14} /></a>
  </div>
</div> : <header class="u-page-head"><h1>继续翻一翻</h1><p>第 {current} 页记录，沿着时间慢慢往前走。</p></header>}
<div class="u-home-layout" data-post-filter-scope data-filter-home>
  <aside class="u-topic-sidebar" aria-label="一级分类">
    <TopicTree posts={allPosts} inline rootsOnly />
  </aside>
  <div class="u-main-grid">
    <section aria-labelledby="recent-title">
      <DailyQuote />
      <div class="u-section-head"><div class="u-list-heading"><h2 id="recent-title">{current === 1 ? '最近记录' : '往日记录'}</h2><span class="u-result-count" data-filter-count role="status" data-enhanced>显示 {posts.length} 篇</span></div><PostFilters /></div>
      <SubcategoryFilters posts={allPosts} />
      <PostList posts={allPosts} initialIds={posts.map(post => post.id)} filters />
      <Pagination current={current} total={total} />
      <a class="u-more" href={href('/archive/')}>去归档里逛逛 <Icon name="right" size={14} /></a>
    </section>
    <aside class="u-sidebar" aria-label="博客介绍与主题">
      <section><h2>关于这片小宇宙</h2><p>不限定主题，<br />也不急着给出答案。<br />把值得记住的事情，<br />一点一点留在这里。</p></section>
      <section><h2>沿着主题探索</h2><div class="u-topic-list">{rootTopics.map(topic => <a href={href(`/categories/${topic.slug}/`)}><span><span class="u-topic-mark"></span>{topic.label}</span><span>{topic.path === '技术' ? '摸索的经验' : '生活的切片'}</span></a>)}</div></section>
      {tags.length > 0 && <section><h2>最近关心的事</h2><div class="u-side-tags">{tags.map(tag => <a href={href(`/tags/${encodeURIComponent(tag)}/`)}>{tag}</a>)}</div></section>}
    </aside>
  </div>
</div>
<script>
  import '../scripts/post-filters';
</script>
<style>
  .u-home-hero .f-home-link { display:inline-flex; align-items:center; gap:8px; margin:18px 0 0 18px; padding:10px 15px; border:1px solid var(--u-line); border-radius:7px; color:var(--u-text); background:color-mix(in srgb,var(--u-paper) 70%,transparent); font-size:13px; }
  .f-home-link svg { width:17px; height:17px; }
  .u-home-hero .f-home-link:hover { background:var(--u-paper); }
  @media(max-width:600px) { .u-home-hero .f-home-link { display:flex; width:max-content; margin:12px 0 0; } }
</style>
