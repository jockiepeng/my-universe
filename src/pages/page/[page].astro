---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HomeContent from '../../components/HomeContent.astro';
import { getPosts } from '../../lib/posts';
import { siteConfig } from '../../site.config';
export async function getStaticPaths() {
  const posts = await getPosts();
  const total = Math.ceil(posts.length / siteConfig.pageSize);
  return Array.from({ length: Math.max(0, total - 1) }, (_, i) => ({ params: { page: String(i + 2) }, props: { current: i + 2 } }));
}
const { current } = Astro.props;
const posts = await getPosts();
const total = Math.ceil(posts.length / siteConfig.pageSize);
---
<BaseLayout title={`记录 · 第 ${current} 页`}><HomeContent posts={posts.slice((current - 1) * siteConfig.pageSize, current * siteConfig.pageSize)} allPosts={posts} current={current} total={total} /></BaseLayout>
