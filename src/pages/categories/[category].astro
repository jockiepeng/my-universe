---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { getPosts, href } from '../../lib/posts';
import { categories, categorySlug } from '../../lib/content.mjs';
export function getStaticPaths() { return categories.map(category => ({ params: { category: categorySlug(category) }, props: { category } })); }
const { category } = Astro.props;
const posts = (await getPosts()).filter(post => post.data.category === category);
---
<BaseLayout title={category}><header class="u-page-head"><h1>{category}</h1><p>{({ 日常: '生活里的片刻，值得留下来。', 随想: '还在生长的念头，也可以先记下来。', 实践: '把摸索过的路，整理成自己的经验。' } as Record<string, string>)[category]}</p></header><div class="u-list-page"><PostList posts={posts} /><a class="u-more" href={href('/archive/')}>返回归档</a></div></BaseLayout>
