---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPosts, href, postHref } from '../lib/posts';
import TopicTree from '../components/TopicTree.astro';
import { formatDateTime } from '../lib/content.mjs';
const posts = await getPosts();
const yearFormat = new Intl.DateTimeFormat('en', { year: 'numeric', timeZone: 'Asia/Shanghai' });
const monthDay = new Intl.DateTimeFormat('zh-CN', { month: '2-digit', day: '2-digit', timeZone: 'Asia/Shanghai' });
const clock = new Intl.DateTimeFormat('zh-CN', { hour: '2-digit', minute: '2-digit', second: '2-digit', hourCycle: 'h23', timeZone: 'Asia/Shanghai' });
const historicalTitle = '历史记录仅精确到日期，00:00:00 不代表实际创建时刻';
const years = [...new Set(posts.map(post => yearFormat.format(post.data.date)))];
const tags = [...new Set(posts.flatMap(post => post.data.tags))];
---
<BaseLayout title="归档">
  <header class="u-page-head"><h1>时间留下的轨迹</h1><p>把零散的记录，放回时间里。</p></header>
  <div class="u-archive-topics"><TopicTree posts={posts} /></div>
  <div class="u-archive">
    {years.map(year => <section class="u-year"><h2>{year}</h2><div class="u-archive-list">
      {posts.filter(post => yearFormat.format(post.data.date) === year).map(post => {
        const updated = post.data.updated || post.data.date;
        return <div class="u-archive-item">
          <time datetime={post.data.date.toISOString()} title={post.data.datePrecision === 'day' ? historicalTitle : '创建时间（北京时间）'}>
            {monthDay.format(post.data.date)}<span class="u-archive-clock">{clock.format(post.data.date)}</span>
          </time>
          <div>
            <a href={postHref(post)}>{post.data.title}</a>
            {post.data.kind === 'photo' && <span class="u-archive-kind">贴图</span>}
            {post.data.example && <span class="u-archive-kind">示例</span>}
            {post.data.draft && <span class="u-archive-kind">草稿</span>}
            <small class="u-archive-updated">最近编辑 <time datetime={updated.toISOString()} title={post.data.datePrecision === 'day' && updated.getTime() === post.data.date.getTime() ? historicalTitle : '北京时间'}>{formatDateTime(updated)}</time></small>
          </div>
        </div>;
      })}
    </div></section>)}
    {posts.length === 0 && <p class="u-empty">第一篇记录，还在路上。</p>}
    {tags.length > 0 && <section class="u-archive-tags"><h2>也可以沿着标签找找</h2><div class="u-side-tags">{tags.map(tag => <a href={href(`/tags/${encodeURIComponent(tag)}/`)}>{tag}</a>)}</div></section>}
  </div>
</BaseLayout>
