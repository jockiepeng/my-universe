---
import BaseLayout from '../layouts/BaseLayout.astro';
import { giscusConfig } from '../site.config';
import snapshot from '../data/moments.json';
import '../styles/moments.css';
import { MOMENTS_PAGE_SIZE } from '../lib/moments-search.mjs';
import { withBase } from '../lib/paths.mjs';

interface Reply { id: string; bodyHTML: string; createdAt: string; author: { login: string; avatarUrl: string } | null }
interface Moment { id: string; bodyHTML: string; createdAt: string; updatedAt: string; url: string; author: { login: string; avatarUrl: string }; replies?: Reply[] }
const moments = snapshot.moments as Moment[];
const number = import.meta.env.PUBLIC_MOMENTS_DISCUSSION_NUMBER || '';
const configured = Boolean(giscusConfig.repoId && giscusConfig.categoryId && /^\d+$/.test(number));
const discussionUrl = `https://github.com/${giscusConfig.repo}/discussions/${number}`;
const date = new Intl.DateTimeFormat('zh-CN', { timeZone: 'Asia/Shanghai', year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit', hourCycle: 'h23' });
---
<BaseLayout title="动态" description="记录生活里值得留下的片刻。">
  <div class="moments-page">
    <header class="moments-header">
      <div><h1>写下此刻</h1><p>记录生活里值得留下的片刻。</p></div>
      <a class="moments-compose" href="#moments-discussion" aria-controls="moments-discussion" aria-expanded="false">发表动态与参与讨论</a>
    </header>
    <details id="moments-discussion" class="moments-discussion" data-pagefind-ignore>
      <summary aria-label="发表动态与参与讨论"></summary>
      <button class="moments-close" type="button" data-moments-close>关闭</button>
      <p>使用 GitHub 账号发表动态，或回复某条动态。</p>
      {configured ? <div data-giscus data-repo={giscusConfig.repo} data-repo-id={giscusConfig.repoId} data-category={giscusConfig.category} data-category-id={giscusConfig.categoryId} data-mapping="number" data-term={number} data-compose-mode="true">
        <p data-comment-status>评论将在滚动到这里时加载，需要登录 GitHub 才能发表评论。</p><div class="giscus"></div>
        <a class="u-comment-fallback" href={discussionUrl} target="_blank" rel="noopener noreferrer">前往 GitHub 查看讨论</a>
      </div> : <p>动态尚未配置。</p>}
      <noscript><p>启用 JavaScript 后可以加载评论。</p></noscript>
    </details>
    <div class="moments-layout">
      <section aria-label="动态" data-moments-base={withBase('/moments-data/', import.meta.env.BASE_URL)} data-moments-version={snapshot.updatedAt || ''} data-moments-total={moments.length}>
        <form class="moments-filters" data-moments-filters hidden>
          <label>搜索动态<input type="search" name="query" placeholder="搜索正文和回复" /></label>
          <label>开始日期<input type="date" name="from" /></label>
          <label>结束日期<input type="date" name="to" /></label>
          <button type="reset">清除筛选</button>
        </form>
        <p class="moments-status" data-moments-status role="status" aria-live="polite"></p>
        <div class="moments-sort"><label for="moments-order">排序</label><select id="moments-order"><option value="newest">最新在前</option><option value="oldest">最早在前</option></select></div>
        <div class="moments-feed">
        {moments.length === 0 && <p class="moments-empty">还没有动态，过段时间再来看看。</p>}
        {moments.slice(0, MOMENTS_PAGE_SIZE).map(moment => <article class="moment-card" data-i18n-skip data-created={moment.createdAt}>
          <div class="moment-avatar"><img src={moment.author.avatarUrl} alt="" loading="lazy" /></div>
          <div class="moment-main">
            <header class="moment-meta"><strong>{moment.author.login}</strong><span class="moment-times"><time datetime={moment.createdAt}>{date.format(new Date(moment.createdAt))}</time>{moment.updatedAt && moment.updatedAt !== moment.createdAt && <small>编辑于 <time datetime={moment.updatedAt}>{date.format(new Date(moment.updatedAt))}</time></small>}</span></header>
            <div class="moment-body" set:html={moment.bodyHTML}></div>
            {moment.replies && moment.replies.length > 0 && <div class="moment-replies"><h3>回复 <span>{moment.replies.length}</span></h3>{moment.replies.map(reply => <article class="moment-response"><div class="response-meta"><strong>{reply.author?.login || '已删除用户'}</strong><time datetime={reply.createdAt}>{date.format(new Date(reply.createdAt))}</time></div><div class="moment-body" set:html={reply.bodyHTML}></div></article>)}</div>}
            <a class="moment-reply" href="#moments-discussion" data-i18n-skip>在页面中回复</a><a class="moment-reply moment-original" href={moment.url} target="_blank" rel="noopener noreferrer" data-i18n-skip>查看、编辑或删除</a>
          </div>
        </article>)}
        </div>
        <nav class="moments-pagination" aria-label="动态分页" data-moments-pagination hidden><button type="button" data-previous>上一页</button><span data-page-label></span><button type="button" data-next>下一页</button></nav>
        <noscript><p>启用 JavaScript 后可搜索动态和浏览其他页面。</p></noscript>
      </section>
      <aside class="moments-note">
        <span class="moments-orbit" aria-hidden="true">✦</span>
        <p>动态和回复会同步更新，发表后请稍候。</p>
        <p>动态列表只显示站长发表的内容，欢迎登录 GitHub 回复。访客发表的独立评论不会出现在动态列表。</p>
        <details class="moments-explainer" data-pagefind-ignore>
          <summary>动态是如何运作的</summary>
          <div class="moments-explainer-body">
            <h2>发表与讨论</h2>
            <p>giscus 把发表的内容保存到 GitHub Discussion。打开讨论区时，giscus 自行获取评论；登录 GitHub 后可以发表或回复。</p>
            <h2>动态列表</h2>
            <p>GitHub Actions 从同一条讨论中分页读取评论和回复，将站长的顶级评论生成快照，再构建并部署动态页面。访客的独立评论仍在讨论区中，不会成为动态卡片。</p>
            <p>列表首次显示前 20 条；搜索正文和回复、按北京时间筛选发布日期或翻页时，浏览器按需加载快照生成的搜索索引和分页数据。</p>
            {snapshot.updatedAt ? <p>此页面的快照生成于 <time datetime={snapshot.updatedAt}>{date.format(new Date(snapshot.updatedAt))}</time>（北京时间）。</p> : <p>此页面尚无已同步的快照时间。</p>}
            <h2>为什么有时显示较慢</h2>
            <p>giscus 和动态列表读取的路径不同：前者从 GitHub 获取评论，后者依赖同步、构建和部署后的快照。因此新评论可能先出现在讨论区，稍后才显示在列表中。</p>
            <p>曾观察到最新动态已进入构建产物，但线上暂时仍返回较旧的页面；之后页面恢复显示。发布传播或缓存可能造成延迟，具体原因尚未确认，不能保证固定等待时间。</p>
          </div>
        </details>
      </aside>
    </div>

  </div>
  <script>
    import '../scripts/article-services';
    import '../scripts/moments';
    const discussion = document.querySelector<HTMLDetailsElement>('#moments-discussion');
    const compose = document.querySelector<HTMLAnchorElement>('.moments-compose');
    discussion?.addEventListener('toggle', () => compose?.setAttribute('aria-expanded', String(discussion.open)));
    document.querySelector<HTMLButtonElement>('[data-moments-close]')?.addEventListener('click', () => {
      if (discussion) discussion.open = false;
      compose?.focus();
    });
    document.addEventListener('click', event => {
      const link = (event.target as Element).closest<HTMLAnchorElement>('a[href="#moments-discussion"]');
      if (link) {
        event.preventDefault();
        if (discussion) {
          const comments = discussion.querySelector<HTMLElement>('[data-giscus]');
          if (comments) { comments.dataset.composeMode = link.classList.contains('moment-reply') ? 'false' : 'true'; window.dispatchEvent(new Event('universe:giscus-mode')); }
          discussion.open = link === compose ? !discussion.open : true;
          if (discussion.open) discussion.scrollIntoView({ block: 'start' });
        }
      }
    });
    if (location.hash === '#moments-discussion') history.replaceState(history.state, '', location.pathname + location.search);
  </script>
</BaseLayout>

