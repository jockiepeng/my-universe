---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LifeCharacter from '../../components/LifeCharacter.astro';
import { STAGES, DEFAULT_WISH } from '../../lib/life-journey.mjs';
import { href } from '../../lib/posts';
import '../../styles/life-grid.css';
import '../../styles/life-journey.css';
---
<BaseLayout title="人生格子" description="跟着每一个年龄的自己，走过人生长卷。以日或周看完整一生，写下未来愿望，生成属于你的分享图片。">
  <section class="l-life" data-life-grid data-unit="day" data-example="true" data-animating="false" data-phase="overview">
    <a class="l-back" href={href('/tools/')}>工具 / 人生格子</a>
    <header class="l-heading"><h1>从小小的你，<br />走到今天的你。</h1><p>那些回不去的日子，连成了走过的路。<br />那些还空着的格子，等你写下新的故事。</p></header>
    <form class="l-form" data-life-form>
      <div class="l-field"><label for="life-birth">出生日期</label><input id="life-birth" name="birth" type="date" min="0001-01-01" required aria-describedby="life-privacy" /></div>
      <div class="l-field"><label for="life-lifespan">预计寿命</label><div class="l-number-field"><input id="life-lifespan" name="lifespan" type="number" min="1" max="120" step="1" value="80" required /><span>岁</span></div></div>
      <button class="l-submit" type="submit" disabled>走一遍我的人生</button>
    </form>
    <p class="l-privacy" id="life-privacy">日期与寄语仅在当前浏览器计算，不保存、不上传。预计寿命由你设定，并非预测。</p>
    <p class="l-error" data-life-error role="alert" hidden></p>
    <noscript><p class="l-error">请启用 JavaScript 来计算和展示人生格子；出生日期不会被提交。</p></noscript>

    <section class="l-observatory lj-observatory" aria-label="人生长卷" data-life-result hidden>
      <div class="l-result-top"><p data-life-context></p><div class="l-switch" role="group" aria-label="格子单位"><button type="button" data-life-unit="day" aria-pressed="true">日</button><button type="button" data-life-unit="week" aria-pressed="false">周</button></div></div>
      <div class="lj-stages" aria-label="人生阶段（展示分段）">
        {STAGES.map((stage, i) => <div class="lj-stage" data-life-stage={stage.id} style={`--stage-color:${stage.color}`}><LifeCharacter stage={stage.id} /><strong>{stage.name}</strong><small>{stage.from}{i < STAGES.length - 1 ? `–${STAGES[i + 1].from - 1}` : '+'} 岁</small></div>)}
      </div>
      <div class="lj-story-line"><div><h2 data-life-story-title>这一格，是今天。</h2><p data-life-story-copy></p></div><div class="lj-story-actions"><button type="button" data-life-pause hidden>暂停</button><button type="button" data-life-skip hidden>跳过演出</button><button type="button" data-life-replay>重播旅程</button></div></div>
      <div class="lj-plot" data-life-viewport>
        <div class="lj-camera-tools" role="group" aria-label="人生地面镜头"><button type="button" data-life-camera="follow" aria-pressed="true">跟随脚步</button><button type="button" data-life-camera="all" aria-pressed="false">看完整地面</button></div>
        <canvas class="l-canvas" data-life-canvas tabindex="0" role="img" aria-label="人生格子图" aria-describedby="life-map-help life-detail">数字统计与格子查询同样提供完整时间信息。</canvas>
        <div class="lj-walker" data-life-walker aria-hidden="true">{STAGES.map(stage => <LifeCharacter stage={stage.id} />)}<span data-life-walker-label></span></div>
        <span class="lj-origin" aria-hidden="true">故事，从这里开始</span>
        <span class="lj-now" data-life-now-label aria-hidden="true">今天</span>
      </div>
      <div class="lj-map-toolbar"><p data-life-map-title>每一格，都是一天。</p><button type="button" data-life-fullscreen-open>全屏看一生 <span aria-hidden="true">⛶</span></button></div>
      <div class="l-legend"><span><i class="l-swatch" data-paint="past"></i>已走过的路</span><span><i class="l-swatch" data-paint="current"></i><span data-life-current-label>今天</span></span><span><i class="l-swatch" data-paint="future"></i>未展开的故事</span></div>
      <div class="l-stats lj-stats" aria-live="polite" aria-atomic="true"><div><span>一生共有 <span data-life-unit-label>天</span></span><strong data-life-total>—</strong></div><div><span>已走过 <span data-life-unit-label>天</span></span><strong data-life-elapsed>—</strong></div><div><span>尚有 <span data-life-unit-label>天</span></span><strong data-life-remaining>—</strong></div></div>
      <div class="l-progress-line"><p>已走过 <strong data-life-percent>—</strong> 的设定人生</p><span data-life-day-summary></span></div>
      <div class="l-progress" role="progressbar" aria-label="按日计算的人生进度" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" data-life-progress><span></span></div>
      <div class="l-ruler"><span data-life-start></span><span data-life-end></span></div>
      <p class="l-map-help" id="life-map-help">点击格子查日期；聚焦图后用方向键移动，Home / End 查看首尾。全屏可一次看全。</p>
      <p class="l-detail" id="life-detail" data-life-detail aria-live="polite"></p>
      <form class="l-query" data-life-query-form><label for="life-query">查看第</label><input id="life-query" data-life-query type="number" min="1" step="1" value="1" required /><span>格</span><button type="submit">查看这一格</button><button type="button" data-life-today>回到今天</button></form>
      <p class="l-count-note" data-life-count-note></p>
    </section>

    <section class="lj-future" data-life-future hidden aria-labelledby="future-title">
      <div class="lj-future-intro"><span class="lj-future-seed" aria-hidden="true"></span><h2 id="future-title">接下来的路，<br />你想怎么走？</h2><p>还有没看过的风景，没说出口的话，<br />还有一个可以从今天开始的愿望。</p></div>
      <div class="lj-wish-editor"><div class="lj-wish-ideas" role="group" aria-label="未来愿望灵感"><button type="button" data-life-idea="去没去过的地方，看看更大的世界。">去远方</button><button type="button" data-life-idea="把更多时间，留给我在意的人。">多陪伴</button><button type="button" data-life-idea="学会一直想学的事，让好奇心继续生长。">学点新东西</button><button type="button" data-life-idea="好好照顾身体，认真过每一天。">照顾自己</button></div><label for="life-wish">写给未来的自己</label><textarea id="life-wish" data-life-wish rows="3" placeholder={DEFAULT_WISH} aria-describedby="wish-help"></textarea><div class="lj-wish-help" id="wish-help"><span>留空会使用上方提示中的寄语，可随时修改。</span><span data-life-wish-count>0 / 80</span></div><button class="l-submit lj-share-open" type="button" data-life-share-open>把这一生，存成一张图</button></div>
    </section>
    <footer class="l-reflection"><p data-life-message>这一格，是今天。</p><span>接下来的故事，由你来写。</span></footer>

    <dialog class="lj-fullscreen" data-life-fullscreen aria-labelledby="fullscreen-title">
      <div class="lj-fullscreen-top"><h2 id="fullscreen-title">你的一生，尽在眼前。</h2><button type="button" data-life-fullscreen-close autofocus aria-label="退出全屏">退出 <span aria-hidden="true">×</span></button></div>
      <div class="lj-fullscreen-bar"><p data-life-fullscreen-summary></p><div class="l-switch" role="group" aria-label="全屏格子单位"><button type="button" data-life-fs-unit="day" aria-pressed="true">日</button><button type="button" data-life-fs-unit="week" aria-pressed="false">周</button></div></div>
      <div class="lj-fullscreen-plot" data-life-fullscreen-plot><canvas data-life-fullscreen-canvas tabindex="0" role="img" aria-label="完整人生格子图，方向键查询日期" aria-describedby="fullscreen-detail"></canvas></div>
      <p class="l-detail" id="fullscreen-detail" data-life-fullscreen-detail aria-live="polite"></p>
      <form class="l-query" data-life-fullscreen-query-form><label for="fullscreen-query">查看第</label><input id="fullscreen-query" data-life-fullscreen-query type="number" min="1" step="1" required /><span>格</span><button type="submit">查看这一格</button><button type="button" data-life-fullscreen-today>今天</button></form>
    </dialog>

    <dialog class="lj-share-dialog" data-life-share-dialog aria-labelledby="share-title">
      <div class="lj-share-heading"><h2 id="share-title">把走过的路，和未来的期待一起留下。</h2><button type="button" data-life-share-close autofocus aria-label="关闭分享预览">×</button></div>
      <p class="lj-share-note">导出完整人生长卷，图片不会上传。也可以打开图片后长按保存。</p>
      <label class="lj-birth-option"><input type="checkbox" data-life-include-birth />在图片中显示出生日期</label>
      <figure><a data-life-image-link target="_blank" rel="noopener" aria-label="打开完整分享图片"><img data-life-poster alt="人生长卷分享图预览" /></a><figcaption data-life-poster-summary></figcaption></figure>
      <p data-life-share-status role="status">正在绘制你的长卷…</p>
      <div class="lj-share-actions"><button type="button" data-life-download disabled>保存图片</button><button type="button" data-life-native-share hidden disabled>分享图片</button></div>
    </dialog>
  </section>
</BaseLayout>
<script>
  import '../../scripts/life-grid';
</script>
